flowchart LR
  subgraph Entry[Customer Channels]
    SITE[Website]
    VIEW["Loyalty View (Web or PWA)"]
    CHECKOUT[ROLLER Checkout]
    EXT["External Events (CRUD)"]
  end

  subgraph GCP[GCP Services]
    FE[Frontend Cloud Run]
    API[Backend API Cloud Run]
    DB[(PostgreSQL Cloud SQL)]
    SCHED[Cloud Scheduler]
    SEC[Secret Manager]
    LOG[Cloud Logging]
  end

  subgraph Providers[External Providers]
    R[ROLLER]
    P[PATCH]
  end

  SITE -->|Open loyalty page| VIEW
  VIEW -->|Manual refresh request| FE
  FE --> API
  API --> DB
  API --> SEC
  FE --> LOG
  API --> LOG

  CHECKOUT -->|Purchase or code redemption| R
  EXT -->|Create, update, cancel booking| R
  R -->|Automation sync for loyalty updates| P
  P -->|POST /webhooks/patch/contact-updated| API
  P -->|POST /webhooks/patch/reward-code| API
  API -->|Store loyalty snapshot and active code array| DB
  API -->|Store used-code invalidation list| DB

  SCHED -->|Run verification job| API
  API -->|Trigger code usage check automation| P
  P -->|Query checkout usage data| R
  R -->|Return usage state| P
  P -->|POST /webhooks/patch/contact-updated| API

  API -->|GET /account response| FE
  FE -->|Show loyalty and code status| VIEW
