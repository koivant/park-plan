flowchart LR
  A["Member signs waiver in ROLLER"] --> B["ROLLER sends waiver data to Loyalty App"]
  B --> C["Loyalty App stores waiver status"]
  C --> D["Member logs in to Loyalty App"]
  D --> E["Loyalty App reads the member waiver record"]
  E --> F{"Waiver on file?"}
  F -- "Yes" --> G["Loyalty App shows waiver status and waiver link"]
  F -- "No" --> H["Loyalty App shows no waiver on file"]

  classDef event fill:#e8f3ff,stroke:#2563eb,color:#111827;
  classDef decision fill:#fff7ed,stroke:#ea580c,color:#111827;
  classDef system fill:#f8fafc,stroke:#64748b,color:#111827;
  classDef success fill:#ecfdf5,stroke:#059669,color:#111827;

  class A event;
  class F decision;
  class B,C,D,E,H system;
  class G success;
