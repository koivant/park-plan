    "/webhooks/roller/booking": {
      "post": {
        "summary": "Consume a ROLLER booking webhook, fetch guest contact by customerId when needed, and acknowledge payload issues with 202.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "sendDate": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "Booking",
                      "Redemption",
                      "Customer",
                      "BulkExport",
                      "SignedWaiver",
                      "PaymentLink"
                    ]
                  },
                  "eventType": {
                    "type": "string",
                    "enum": [
                      "Created",
                      "Updated",
                      "Cancelled",
                      "Deleted"
                    ]
                  },
                  "eventDate": {
                    "type": "string",
                    "minLength": 1
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "bookingReference": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        ]
                      },
                      "uniqueId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "customerId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        ]
                      },
                      "email": {
                        "type": "string"
                      },
                      "firstName": {
                        "type": "string",
                        "minLength": 1
                      },
                      "lastName": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "phone": {
                        "type": "string",
                        "minLength": 1
                      },
                      "venue": {
                        "type": "string",
                        "minLength": 1
                      },
                      "startsAt": {
                        "type": "string",
                        "minLength": 1
                      },
                      "ticketCount": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "status": {
                        "type": "string",
                        "minLength": 1
                      },
                      "items": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "quantity": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "bookingDate": {
                                "type": "string",
                                "minLength": 1
                              },
                              "sessionStartTime": {
                                "type": "string",
                                "minLength": 1
                              },
                              "sessionEndTime": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "additionalProperties": {}
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "quantity": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "bookingDate": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "sessionStartTime": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "sessionEndTime": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "additionalProperties": {}
                            }
                          }
                        ]
                      }
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "id",
                  "sendDate",
                  "type",
                  "eventType",
                  "eventDate",
                  "data"
                ],
                "additionalProperties": {}
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Webhook accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
