                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "home_park": {
                      "nullable": true,
                      "type": "object",
                      "properties": {
                        "parkId": {
                          "nullable": true,
                          "type": "string"
                        },
                        "parkName": {
                          "nullable": true,
                          "type": "string"
                        }
                      }
                    },
                    "visited_parks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "parkId": {
                            "type": "string"
                          },
                          "parkName": {
                            "nullable": true,
                            "type": "string"
                          },
                          "firstSeenAt": {
                            "nullable": true,
                            "type": "string"
                          },
                          "lastSeenAt": {
                            "nullable": true,
                            "type": "string"
                          },
                          "visitCount": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "parkId"
                        ],
                        "additionalProperties": {}
                      }
                    },
                    "profile": {
                      "type": "object",
                      "properties": {
                        "email": {
                          "type": "string"
                        },
                        "name": {
                          "nullable": true,
                          "type": "string"
                        },
                        "firstName": {
                          "nullable": true,
                          "type": "string"
                        },
                        "lastName": {
                          "nullable": true,
                          "type": "string"
                        },
                        "phone": {
                          "nullable": true,
                          "type": "string"
                        }
                      },
                      "additionalProperties": {}
                    },
                    "upcoming_bookings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "bookingId": {
                            "type": "string"
                          },
                          "venue": {
                            "type": "string"
                          },
                          "parkId": {
                            "type": "string"
                          },
                          "startsAt": {
                            "nullable": true,
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "ticketCount": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        },
                        "additionalProperties": {}
                      }
                    },
                    "waivers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "waiverId": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "signedAt": {
                            "nullable": true,
